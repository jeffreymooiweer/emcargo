# EMCargo, native installation: read by the systemd unit as EnvironmentFile.
# Every variable is documented in docs/configuration.md; these are the ones a
# native install must or usually wants to set.
APP_ENV=production
EMCARGO_MODE=organisation
DATA_DIR=/var/lib/emcargo
DATABASE_URL=sqlite:////var/lib/emcargo/emcargo.db
# The first administrator, created on the first start when no admin exists.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
# The address you reach EMCargo on, behind your reverse proxy.
CORS_ALLOWED_ORIGINS=https://emcargo.example.com
PUBLIC_URL=https://emcargo.example.com
TRUSTED_PROXY_HEADERS=true
TRUSTED_PROXY_COUNT=1
LOG_LEVEL=INFO
