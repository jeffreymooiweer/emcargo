TZ=Europe/Amsterdam
APP_NAME=EMCargo
APP_ENV=production
# Which application this is. "organisation": people sign in, and the server
# keeps their accounts, settings and equipment library. "open": no accounts
# at all — anyone may use it, nothing is kept about anyone, and the routes
# that would presume an account are not mounted. See docs/privacy.md.
EMCARGO_MODE=organisation
# Signs the login tokens. Leave it empty and EMCargo makes one on first
# start, keeps it in DATA_DIR/secret_key and uses it from then on. Fill it in
# only if you want to manage the key yourself, to share it across several
# instances for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATA_DIR=/data
DATABASE_URL=sqlite:////data/cargopilot.db
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# The addresses you reach EMCargo on. '*' produces a warning in production:
# browsers refuse to combine that with cookies, so a call from another domain
# does not work anyway.
CORS_ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_PROXY_HEADERS=true
# How many reverse proxies stand in front. It decides which X-Forwarded-For
# entry the sign-in rate limit is counted against: one nginx, Caddy or Traefik
# is 1, a CDN in front of that is 2. Too high and everyone shares one budget;
# too low and the limit is keyed on a value the caller writes themselves.
TRUSTED_PROXY_COUNT=1
# Empty = Secure automatically on HTTPS or X-Forwarded-Proto=https.
# Set it explicitly to false only when EMCargo is deliberately used over
# plain HTTP; true forces Secure on a direct HTTP call as well.
COOKIE_SECURE=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CATALOG_AUTO_SYNC=true
CATALOG_SYNC_TIMEOUT_SECONDS=20
GEO_ADDRESS_API_URL=https://photon.komoot.io/api
GEO_ADDRESS_TIMEOUT_SECONDS=8
