TZ=Europe/Amsterdam
APP_NAME=EMCargo
APP_ENV=production
# Every installation requires an account. Set ADMIN_PASSWORD before starting.
# Signs the login tokens. Leave it empty and EMCargo makes one on first
# start, keeps it in DATA_DIR/secret_key and uses it from then on. Fill it in
# only if you want to manage the key yourself, to share it across several
# instances for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATA_DIR=/data
DATABASE_URL=sqlite:////data/emcargo.db
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=
LOG_LEVEL=INFO
# The bundled interface needs no cross-origin access. Set an explicit origin
# only when a separate website must access this API. '*' allows anonymous
# cross-origin reads, never credentialed ones, and warns in production.
CORS_ALLOWED_ORIGINS=
# Enable only when this backend is reachable exclusively through proxies
# whose forwarded headers are controlled by the operator.
TRUSTED_PROXY_HEADERS=false
# How many reverse proxies stand in front. It decides which X-Forwarded-For
# entry the sign-in rate limit is counted against: one nginx, Caddy or Traefik
# is 1, a CDN in front of that is 2. A wrong count may share a budget between
# callers or trust an entry supplied by the caller rather than a proxy.
TRUSTED_PROXY_COUNT=1
# Empty = Secure automatically on HTTPS or X-Forwarded-Proto=https.
# Set it explicitly to false only when EMCargo is deliberately used over
# plain HTTP; true forces Secure on a direct HTTP call as well.
COOKIE_SECURE=
ACCESS_TOKEN_EXPIRE_MINUTES=480
CATALOG_AUTO_SYNC=true
CATALOG_SYNC_TIMEOUT_SECONDS=20
GEO_ADDRESS_API_URL=https://photon.komoot.io/api
GEO_ADDRESS_TIMEOUT_SECONDS=8

# In-app updates require explicit access to the Docker socket.
# See docker-compose.updates.yml for the optional Compose configuration.
UPDATE_APPLY_ENABLED=false
UPDATE_CHECK_ENABLED=true
